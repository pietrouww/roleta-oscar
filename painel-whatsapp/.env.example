# =====================================================================
#  Painel de pendências - configuração
#  Copie para .env (cp .env.example .env) e preencha.
# =====================================================================

# --- Chatwoot ---------------------------------------------------------
# Endereço do seu Chatwoot. Se o painel roda no mesmo VPS, pode usar o
# endereço público (https://...) ou o interno: http://host.docker.internal:3000
CHATWOOT_URL=https://atendimento.seudominio.com.br
# Endereço que os atendentes abrem no celular (botão "Abrir no Chatwoot")
CHATWOOT_PUBLIC_URL=https://atendimento.seudominio.com.br
# Número da conta: aparece na URL do Chatwoot, ex.: .../app/accounts/1/dashboard -> 1
CHATWOOT_ACCOUNT_ID=1
# Token de acesso: Chatwoot > clique na sua foto > Configurações do perfil > Token de acesso
# Use o token de um usuário ADMINISTRADOR (precisa ver todas as conversas).
CHATWOOT_API_TOKEN=
# Opcional: monitorar só algumas caixas de entrada (IDs separados por vírgula). Vazio = todas.
INBOX_IDS=

# --- WhatsApp por QR Code (Evolution API) -----------------------------
# Chave secreta da Evolution API. Gere com: openssl rand -hex 24
EVOLUTION_API_KEY=
# Senha do banco da Evolution. Gere com: openssl rand -hex 16
EVOLUTION_DB_PASSWORD=
# Endereço público da Evolution. O Chatwoot usa esse endereço para mandar as
# respostas dos atendentes para o WhatsApp, então precisa abrir de fora.
EVOLUTION_PUBLIC_URL=https://evolution.seudominio.com.br
EVOLUTION_DOMINIO=evolution.seudominio.com.br
# Token do Chatwoot que a Evolution usa. Recomendado: crie no Chatwoot um usuário
# ADMINISTRADOR chamado "Celular" e use o token dele aqui. Assim, mensagens que
# alguém mandar direto pelo celular aparecem como "Celular" no Chatwoot e no painel.
# Vazio = usa o CHATWOOT_API_TOKEN.
CHATWOOT_TOKEN_CELULAR=
# Endereço do Chatwoot visto de dentro da Evolution (vazio = CHATWOOT_URL)
EVOLUTION_CHATWOOT_URL=

# --- Segurança --------------------------------------------------------
# Frase longa e aleatória. Gere com: openssl rand -hex 32
SESSION_SECRET=

# --- Horários das verificações -----------------------------------------
CHECK_TIMES=08:30,12:00,17:00
# 1=segunda ... 6=sábado (0=domingo)
CHECK_DAYS=1-6
TZ_PAINEL=America/Sao_Paulo

# --- Regras de pendência ----------------------------------------------
# Cliente sem resposta conta como pendente depois de X minutos
WAIT_MIN_MINUTES=15
# "Vou verificar / já te retorno" sem retorno conta como pendente depois de X minutos
PROMISE_MIN_MINUTES=30
# Alerta imediato no celular quando a promessa passar de X minutos sem retorno
PROMISE_ALERT_MINUTES=120
# Frases extras de promessa / pedido de atendente (separadas por vírgula)
PROMISE_EXTRA_TERMS=
ATTENDANT_EXTRA_TERMS=

# --- Selo IA ----------------------------------------------------------
# sem_usuario: toda resposta que não veio de um atendente do Chatwoot ganha o selo "IA"
#              (respostas da IA da Meta, robôs e automações).
# assinatura:  só ganha o selo "IA" a mensagem que bater com AI_SIGNATURE_REGEX;
#              as outras enviadas fora do Chatwoot aparecem como "Celular".
AI_DETECTION=sem_usuario
AI_SIGNATURE_REGEX=

# --- Alertas contínuos ------------------------------------------------
# Verifica a cada X minutos se alguém pediu atendente / se um retorno atrasou
LIVE_INTERVAL_MINUTES=5
# Só manda esses alertas imediatos neste horário (nos dias de CHECK_DAYS)
LIVE_ALERT_WINDOW=07:00-19:00

# --- Etiquetas no Chatwoot --------------------------------------------
# Coloca/retira automaticamente etiquetas nas conversas pendentes, para a
# equipe ver dentro do próprio Chatwoot. Crie-as em Configurações > Etiquetas.
LABELS_SYNC=true
LABEL_SEM_RESPOSTA=pendente-resposta
LABEL_PEDIU_ATENDENTE=pediu-atendente
LABEL_RETORNO_PROMETIDO=retorno-prometido

# --- Notificações (opcional) ------------------------------------------
# Se ficar vazio, as chaves são geradas sozinhas e salvas em data/vapid.json
VAPID_SUBJECT=mailto:seu-email@seudominio.com.br
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- HTTPS com o Caddy do docker-compose (perfil "https") --------------
# (o EVOLUTION_DOMINIO acima também recebe HTTPS automático)
PAINEL_DOMINIO=painel.seudominio.com.br

# --- Teste sem Chatwoot -----------------------------------------------
# true = usa conversas fictícias (qualquer e-mail e senha entram)
DEMO=false
